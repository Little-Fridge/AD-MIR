# OpenAI-compatible chat/VLM endpoint.
OPENAI_API_KEY=<your-api-key-or-empty-for-local>
OPENAI_BASE_URL=<https-or-local-openai-compatible-v1-endpoint>

# Optional: use a different endpoint for local/vLLM chat calls.
# ADMIR_LOCAL_VLLM_BASE_URL=<openai-compatible-v1-endpoint>

# Model deployments. You may set ADMIR_DEFAULT_LMM_MODEL once, or override
# each component below.
ADMIR_DEFAULT_LMM_MODEL=<your-default-lmm-or-vlm>
ADMIR_CAPTION_VLM_MODEL=<your-caption-vlm>
ADMIR_ORCHESTRATOR_LLM_MODEL=<your-controller-llm>
ADMIR_FRAME_INSPECT_MODEL=<your-frame-inspection-vlm>
ADMIR_COMMUNICATION_EXPERT_MODEL=<your-communication-expert-model>
ADMIR_REFINE_LLM_MODEL=<your-refinement-llm>

# Embeddings. Use "hf" for a local HuggingFace/FlagEmbedding model or
# "openai" for an OpenAI-compatible embedding endpoint.
ADMIR_EMBEDDING_BACKEND=hf
ADMIR_HF_EMBEDDING_MODEL=<local-path-or-hf-model-id>
ADMIR_HF_EMBEDDING_DIM=1024
# ADMIR_EMBEDDING_BACKEND=openai
# ADMIR_EMBEDDING_ENDPOINT=<embedding-v1-endpoint>
# ADMIR_OPENAI_EMBEDDING_MODEL=<embedding-model>
# ADMIR_OPENAI_EMBEDDING_DIM=3072

# ASR model used by add_asr_ocr.py.
ADMIR_ASR_MODEL=<local-path-or-hf-asr-model-id>

# Runtime knobs.
ADMIR_STRICT_PAPER_MODE=0
ADMIR_VIDEO_FPS=1
ADMIR_CLIP_SECS=5
ADMIR_GLOBAL_BROWSE_TOPK=40
ADMIR_CLIP_SEARCH_MIN_TOPK=5
ADMIR_CLIP_SEARCH_TOPK=8
ADMIR_MAX_ITERATIONS=8
